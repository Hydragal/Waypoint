# --- Electron runtime (shipped via GitHub Releases, not source) ---
system/*
!system/app/
!system/resources/
system/resources/*
!system/resources/app/

# --- per-install state ---
system/userdata/
system/app/.deploy-bak-*/

# --- the campaign itself: saves, images, preferences.json — private to the table ---
saves/

# --- build outputs (attach to Releases instead) ---
Waypoint_Setup.exe
*_Drive_Package.zip
*.zip

# --- a private key never enters the repository (the update signing key is kept outside it: tools/signkey.js) ---
*.pem

# --- local clutter ---
Not used/
scratch/
# the house reference for the coding tool: kept on the maintainer's machine, never in the repository
CLAUDE.md
# the roadmap: kept on the maintainer's machine, never in the repository (the Marketing project's legal work order, 2026-10-24)
IMPROVEMENTS.md
log.txt
Waypoint.lnk
*.bak
*.tmp
Thumbs.db
desktop.ini
dev-saves/
dist/

# --- Claude Code local config (machine/session-specific paths) ---
.claude/

# --- internal planning docs (markdown): local only, never committed. Non-.md assets in docs/
#     (e.g. the README's SmartScreen image) stay tracked without a per-file exception ---
docs/*.md
# ...and every folder under docs/ (local research and the owner's own campaign build): never committed, on any clone
/docs/*/
# an outside sheet reader of the owner's own (a bridge to a sheet website): the private/ folder at the repository's root alone, kept on the
# owner's machine, served by tools/dev-server.js only
/private/
